NODE_ENV=production
PORT={{ app_port }}
MONGO_URI=mongodb://{{ mongo_app_username | urlencode }}:{{ mongo_app_password | urlencode }}@{{ mongo_private_ip }}:27017/{{ mongo_database_name }}?authSource={{ mongo_database_name }}
CORS_ORIGIN={{ app_public_url }}
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
TRUST_PROXY=1
