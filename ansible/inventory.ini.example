[web]
travelmemory-web ansible_host=REPLACE_WITH_WEB_PUBLIC_IP

[database]
travelmemory-database ansible_host=REPLACE_WITH_DATABASE_PRIVATE_IP ansible_ssh_common_args="-o ProxyJump=ubuntu@REPLACE_WITH_WEB_PUBLIC_IP"

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=/home/YOUR_LINUX_USER/.ssh/travelmemory-terraform
ansible_python_interpreter=/usr/bin/python3
